/**
 * V2 信息架构下的导航壳层级：控制底栏可见性与标题栏语义。
 */
export enum YoNavDestinationKind {
  /** 根 Tab 目的地：工作台、模块概览、更多 — 显示底栏。 */
  ROOT_TAB = 0,
  /** 模块二级列表/配置 — 隐藏底栏，显示返回。 */
  MODULE = 1,
  /** 设备/会话/对象详情 — 隐藏底栏。 */
  OBJECT = 2,
  /** 终端/工作台页 — 隐藏底栏，会话区装饰。 */
  TERMINAL = 3,
  /** 半模态 / 对话框 — 无应用壳装饰。 */
  MODAL = 4
}
